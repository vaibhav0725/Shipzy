{
  "name": "shipzy",
  "version": "0.1.0-beta.2",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "shipzy": "dist/shipzy.mjs"
  },
  "files": [
    "dist/shipzy.mjs",
    "assets",
    "!assets/dashboard"
  ],
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p . --noEmit && node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1159.0",
    "@aws-sdk/client-cloudformation": "^3.1159.0",
    "@aws-sdk/client-cloudfront": "^3.1159.0",
    "@aws-sdk/client-cloudwatch": "^3.1161.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1159.0",
    "@aws-sdk/client-codebuild": "^3.1159.0",
    "@aws-sdk/client-lambda": "^3.1161.0",
    "@aws-sdk/client-route-53": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-secrets-manager": "^3.1159.0",
    "@aws-sdk/client-ssm": "^3.1159.0",
    "@aws-sdk/client-sts": "^3.1159.0",
    "@aws-sdk/credential-providers": "^3.1159.0",
    "@shipzy/core": "*",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "commander": "^15.0.0",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.2",
    "ignore": "^7.0.0",
    "mime-types": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "private": false,
  "description": "Deploy static React and Next.js sites to your own AWS account (S3 + CloudFront)",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibhav0725/Shipzy.git"
  },
  "homepage": "https://shipzy.quantav.xyz",
  "bugs": {
    "url": "https://github.com/vaibhav0725/Shipzy/issues"
  },
  "keywords": [
    "aws",
    "s3",
    "cloudfront",
    "deploy",
    "static-site",
    "nextjs",
    "react",
    "vite",
    "self-hosted",
    "vercel-alternative"
  ],
  "author": "vaibhav0725",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
